# Contact delivery (server-side only; never prefix these with NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_RATE_LIMIT_SECRET=

# Optional public contact and booking links
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
