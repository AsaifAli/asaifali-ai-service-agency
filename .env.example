
# Public production URL
# Used for canonical metadata, social links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared AI gateway used by optional live demonstrations.
NEXT_PUBLIC_LLM_GATEWAY_URL=https://portfolio-llm-gateway.onrender.com

# Contact delivery. These are server-side values only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Private server-side secret used to hash contact rate-limit keys.
CONTACT_RATE_LIMIT_SECRET=

# The request header overwritten by the hosting proxy with the client IP.
# Confirm the correct header in your hosting provider before production use.
CONTACT_IP_HEADER=x-real-ip

# Optional public contact email and booking link.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
